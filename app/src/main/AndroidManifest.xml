<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin kamera untuk scan QR Code -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyLaundry">

        <!-- Google AdMob: ID aplikasi pengujian -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Scanner QR ZXing: paksa orientasi vertikal -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <!-- Halaman awal aplikasi -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Halaman Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Register -->
        <activity
            android:name=".Register"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Pemesanan -->
        <activity
            android:name=".Pesan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Transaksi -->
        <activity
            android:name=".Transaksi"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Daftar Pesanan -->
        <activity
            android:name=".DaftarPesanan"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Scan QR -->
        <activity
            android:name=".QRActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Profil -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Halaman Notifikasi -->
        <activity
            android:name=".NotifikasiActivity"
            android:exported="false" />

        <!-- Halaman Tracking -->
        <activity
            android:name=".TrackingActivity"
            android:exported="false" />

    </application>

</manifest>