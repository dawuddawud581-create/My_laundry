<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B18"
    android:padding="20dp">

    <!-- Judul -->
    <TextView
        android:id="@+id/txtJudulQR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SCAN QR PESANAN"
        android:textColor="#00F5FF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Petunjuk -->
    <TextView
        android:id="@+id/txtPetunjukQR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Arahkan kamera ke QR Code pada kartu pesanan MyLaundry."
        android:textColor="#A7B4D0"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtJudulQR"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ikon scanner -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardScanner"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="#111A2E"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtPetunjukQR"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▦"
            android:textColor="#00F5FF"
            android:textSize="54sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

    <!-- Status pemindaian -->
    <TextView
        android:id="@+id/txtStatusScan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Pemindai QR siap digunakan"
        android:textColor="#39FF88"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/cardScanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel hasil scan -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHasilScan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#111A2E"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtStatusScan"
        app:layout_constraintBottom_toTopOf="@id/btnTutupQR"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/scrollHasilScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="16dp"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/txtHasilScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hasil pemindaian pesanan akan ditampilkan di sini."
                android:textColor="#A7B4D0"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="5dp" />

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- Tombol kembali -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTutupQR"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="4dp"
        android:text="KEMBALI"
        android:textColor="#080B18"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#00F5FF"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>