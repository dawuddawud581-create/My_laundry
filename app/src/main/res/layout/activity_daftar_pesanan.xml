<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B18"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Tombol Kembali -->
        <TextView
            android:id="@+id/btnKembaliDaftar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Kembali"
            android:textColor="#00F5FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daftar Pesanan"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- Garis Neon -->
        <View
            android:layout_width="78dp"
            android:layout_height="4dp"
            android:background="#00F5FF"
            android:layout_marginTop="10dp" />

        <!-- Subjudul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelola dan lihat detail pesanan laundry kamu."
            android:textColor="#A7B4D0"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp" />

        <!-- Informasi QR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="#111A2E"
            android:layout_marginBottom="22dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="▦"
                android:textColor="#00F5FF"
                android:textSize="27sp"
                android:textStyle="bold"
                android:background="#1A3044" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="QR Code Pesanan"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buka QR melalui kartu pesanan masing-masing."
                    android:textColor="#A7B4D0"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Pesanan Kosong -->
        <TextView
            android:id="@+id/txtPesananKosong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada pesanan yang dikonfirmasi."
            android:textColor="#A7B4D0"
            android:textSize="15sp"
            android:gravity="center"
            android:padding="28dp"
            android:background="#111A2E"
            android:visibility="gone" />

        <!-- Container Daftar Pesanan -->
        <LinearLayout
            android:id="@+id/containerDaftarPesanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MY LAUNDRY  •  SMART LAUNDRY SERVICE"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

</ScrollView>