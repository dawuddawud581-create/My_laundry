<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070B16"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <!-- KONTEN UTAMA -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/bgn"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <!-- LOGO DAN TOMBOL PROFIL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ML"
                            android:textColor="#00FFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="cursive"
                            android:text="My Laundry"
                            android:textColor="#FFFFFF"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:letterSpacing="0.12"
                            android:text="LAUNDRY SERVICE"
                            android:textColor="#00F5FF"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- NOTIFIKASI -->
                    <TextView
                        android:id="@+id/btnNotifikasi"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_input_register"
                        android:clickable="true"
                        android:contentDescription="Notifikasi"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="♧"
                        android:textColor="#00FFFF"
                        android:textSize="25sp" />

                    <!-- PROFIL -->
                    <TextView
                        android:id="@+id/btnProfil"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_input_register"
                        android:clickable="true"
                        android:contentDescription="Profil pengguna"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="20sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Selamat Datang!"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Pakaian bersih, wangi, dan segar.\nKami siap merawat pakaian kesayanganmu."
                    android:textColor="#C2D5F5"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_input_register"
                    android:paddingStart="14dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="9dp"
                    android:text="✦  LAYANAN LAUNDRY TERPERCAYA"
                    android:textColor="#00FFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TRACKING PESANAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tracking Pesanan"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Pantau progres laundry kamu"
                            android:textColor="#8FA6C8"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_register"
                        android:padding="8dp"
                        android:text="● DIPROSES"
                        android:textColor="#00FFD0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:background="#26354E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="NOMOR PESANAN"
                    android:textColor="#8FA6C8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- ID PESANAN DINAMIS -->
                <TextView
                    android:id="@+id/txtIdPesananHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Belum ada pesanan"
                    android:textColor="#00FFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Progres pengerjaan"
                        android:textColor="#C2D5F5"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40%"
                        android:textColor="#00FFD0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="9dp"
                    android:max="100"
                    android:progress="40"
                    android:progressBackgroundTint="#28344A"
                    android:progressTint="#00FFD0" />

                <!-- TIMELINE TRACKING -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="✓   Pesanan diterima"
                        android:textColor="#00FFD0"
                        android:textSize="13sp"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓   Pakaian sedang dicuci"
                        android:textColor="#00FFD0"
                        android:textSize="13sp"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="○   Penyetrikaan"
                        android:textColor="#8FA6C8"
                        android:textSize="13sp"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="○   Siap diambil"
                        android:textColor="#8FA6C8"
                        android:textSize="13sp"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="○   Selesai"
                        android:textColor="#8FA6C8"
                        android:textSize="13sp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTracking"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="Lihat Detail Tracking  →"
                    android:textAllCaps="false"
                    android:textColor="#07111F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#00BFEF"
                    app:cornerRadius="14dp"
                    app:strokeColor="#00FFFF"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- LAYANAN KAMI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Layanan Kami"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="18dp"
                    android:text="Pilih layanan sesuai kebutuhanmu"
                    android:textColor="#8FA6C8"
                    android:textSize="13sp" />

                <!-- BARIS MENU PERTAMA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- PESAN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button3"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:gravity="center"
                            android:stateListAnimator="@null"
                            android:text="🧺\nPesan"
                            android:textAllCaps="false"
                            android:textColor="#07111F"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            app:backgroundTint="#00BFEF"
                            app:cornerRadius="18dp"
                            app:strokeColor="#00FFFF"
                            app:strokeWidth="1dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp"
                            android:text="Buat pesanan baru"
                            android:textColor="#B9C9E4"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- DAFTAR PESANAN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button2"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:gravity="center"
                            android:stateListAnimator="@null"
                            android:text="📋\nDaftar Pesanan"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="#7952FF"
                            app:cornerRadius="18dp"
                            app:strokeColor="#A58BFF"
                            app:strokeWidth="1dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp"
                            android:text="Lihat daftar cucian"
                            android:textColor="#B9C9E4"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- BARIS MENU KEDUA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- TRANSAKSI -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTransaksi"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:gravity="center"
                            android:stateListAnimator="@null"
                            android:text="💳\nTransaksi"
                            android:textAllCaps="false"
                            android:textColor="#061914"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            app:backgroundTint="#00BFA5"
                            app:cornerRadius="18dp"
                            app:strokeColor="#00FFD0"
                            app:strokeWidth="1dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp"
                            android:text="Pembayaran pesanan"
                            android:textColor="#B9C9E4"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- RIWAYAT PESANAN -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card"
                        android:elevation="6dp"
                        android:orientation="vertical"
                        android:padding="7dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button6"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:gravity="center"
                            android:stateListAnimator="@null"
                            android:text="🕘\nRiwayat Pesanan"
                            android:textAllCaps="false"
                            android:textColor="#26091F"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="#FF4FD8"
                            app:cornerRadius="18dp"
                            app:strokeColor="#FF9BE9"
                            app:strokeWidth="1dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp"
                            android:text="Cek pesanan sebelumnya"
                            android:textColor="#B9C9E4"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- BANNER INFORMASI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:background="#111C32"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨  Fresh Clothes, Happy Days!"
                        android:textColor="#00F5FF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView13"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Cuci Bersih, Wangi Melimpah,\nBebas Bau Apek Mantan!"
                        android:textColor="#D1DEF5"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="52dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="15dp"
                        android:background="#00F5FF" />

                </LinearLayout>

                <!-- KEUNGGULAN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="13dp"
                    android:text="Kenapa My Laundry?"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#101A2D"
                    android:elevation="4dp"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="✦\nBersih\nMaksimal"
                        android:textColor="#00F5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="❋\nWangi\nMenyegarkan"
                        android:textColor="#00FFD0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="✓\nPraktis\nTerpercaya"
                        android:textColor="#B18CFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- FOOTER -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="MY LAUNDRY  •  CARE WITH LOVE"
                    android:textColor="#7187A9"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/bg_card_neon"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#00F5FF"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#00F5FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PESANAN -->
        <LinearLayout
            android:id="@+id/btnNavPesanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▤"
                android:textColor="#8FA6C8"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesanan"
                android:textColor="#8FA6C8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- QR SAYA -->
        <LinearLayout
            android:id="@+id/btnNavQR"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="52dp"
                android:layout_height="42dp"
                android:background="@drawable/home"
                android:gravity="center"
                android:text="▦"
                android:textColor="#00FFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="QR Saya"
                android:textColor="#00FFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TRANSAKSI -->
        <LinearLayout
            android:id="@+id/btnNavTransaksi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◇"
                android:textColor="#8FA6C8"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaksi"
                android:textColor="#8FA6C8"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>