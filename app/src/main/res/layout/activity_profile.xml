<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="25dp">

            <ImageButton
                android:id="@+id/btnBackProfile"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/profile_button_bg"
                android:contentDescription="Kembali"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="PROFIL SAYA"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <View
                android:layout_width="46dp"
                android:layout_height="46dp" />
        </LinearLayout>

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/profile_card_bg">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/profile_avatar_bg"
                android:padding="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:contentDescription="Foto profil"
                app:tint="#00E5FF" />

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Pengguna MyLaundry"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="user@mylaundry.com"
                android:textColor="#AAB5D0"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/profile_badge_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:text="MEMBER MYLAUNDRY"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/profile_button_primary"
                android:text="Edit Profil"
                android:textAllCaps="false"
                android:textColor="#07111F"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Account Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"
            android:text="INFORMASI AKUN"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/profile_card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Pengguna"
                android:textColor="#8D9AB8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtUsernameProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pengguna MyLaundry"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#27314A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#8D9AB8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtEmailProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="user@mylaundry.com"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#27314A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status Akun"
                android:textColor="#8D9AB8"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Aktif"
                android:textColor="#48E6A5"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"
            android:text="LAINNYA"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <Button
            android:id="@+id/btnSettingsProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/profile_card_bg"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:text="⚙    Pengaturan Akun"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnLogoutProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/profile_logout_bg"
            android:text="Keluar dari Akun"
            android:textAllCaps="false"
            android:textColor="#FF7185"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="MyLaundry • Versi 1.0"
            android:textColor="#687590"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>