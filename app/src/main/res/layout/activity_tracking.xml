<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08111F"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnBackTracking"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/tracking_button_bg"
                android:contentDescription="Kembali"
                android:padding="12dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tracking Pesanan"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pantau perjalanan laundry kamu"
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- KARTU STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tracking_card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NOMOR PESANAN DAN STATUS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOMOR PESANAN"
                        android:textColor="#91A4BC"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/txtNomorTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Belum ada pesanan"
                        android:textColor="#35D9F5"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtBadgeTracking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tracking_badge_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="Diproses"
                    android:textColor="#35D9F5"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:background="#243449" />

            <!-- PROGRES PENGERJAAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progres Pengerjaan"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressTracking"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="40"
                    android:progressBackgroundTint="#26364A"
                    android:progressTint="#35D9F5" />

                <TextView
                    android:id="@+id/txtPersenTracking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="40%"
                    android:textColor="#35D9F5"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtDeskripsiTracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pakaian kamu sedang dalam proses pencucian."
                android:textColor="#A5B4C8"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- ESTIMASI SELESAI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/tracking_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/tracking_badge_bg"
                android:gravity="center"
                android:text="⏱"
                android:textColor="#35D9F5"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimasi Selesai"
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtEstimasiTracking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Menunggu konfirmasi"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- JUDUL TIMELINE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="18dp"
            android:text="Perjalanan Laundry"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- TAHAP 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timelineIcon1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/tracking_badge_bg"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#35D9F5"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="58dp"
                    android:background="#35D9F5" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:background="@drawable/tracking_card_bg"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesanan Diterima"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Pesanan sudah masuk ke sistem laundry."
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/waktuTracking1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Tahap selesai"
                    android:textColor="#35D9F5"
                    android:textSize="10sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- TAHAP 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timelineIcon2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/tracking_badge_bg"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#35D9F5"
                    android:textSize="14sp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="58dp"
                    android:background="#35D9F5" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:background="@drawable/tracking_card_bg"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pakaian Sedang Dicuci"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Pakaian sedang melalui proses pencucian."
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/waktuTracking2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Sedang berlangsung"
                    android:textColor="#35D9F5"
                    android:textSize="10sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- TAHAP 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timelineIcon3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/tracking_badge_bg"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#91A4BC"
                    android:textSize="13sp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="58dp"
                    android:background="#26364A" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:background="@drawable/tracking_card_bg"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penyetrikaan dan Finishing"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Pakaian akan disetrika dan dirapikan."
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- TAHAP 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="34dp"
                android:layout_height="match_parent"
                android:gravity="top|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timelineIcon4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/tracking_badge_bg"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="#91A4BC"
                    android:textSize="13sp" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="58dp"
                    android:background="#26364A" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:background="@drawable/tracking_card_bg"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Siap Diambil"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Kami akan memberi informasi saat laundry siap."
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- TAHAP 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timelineIcon5"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/tracking_badge_bg"
                android:gravity="center"
                android:text="5"
                android:textColor="#91A4BC"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/tracking_card_bg"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pesanan Selesai"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Pesanan selesai setelah laundry diterima pelanggan."
                    android:textColor="#91A4BC"
                    android:textSize="12sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- CATATAN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Status pada halaman ini masih berupa data contoh."
            android:textColor="#71839A"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>