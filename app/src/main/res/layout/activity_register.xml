<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never"
    tools:context=".Register">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="38dp"
        android:paddingBottom="32dp">

        <!-- HEADER NEON -->

        <TextView
            android:id="@+id/textView10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:shadowColor="#00F5FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="26dp"
            android:text="Buat akun untuk menikmati layanan My Laundry"
            android:textColor="#BBD7F5"
            android:textSize="13sp"
            android:gravity="center" />

        <!-- REGISTER CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F210192D"
            app:cardCornerRadius="26dp"
            app:cardElevation="12dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daftar Akun Baru"
                    android:textColor="#00F5FF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="22dp"
                    android:text="Lengkapi informasi berikut dengan benar."
                    android:textColor="#BBD0EA"
                    android:textSize="13sp" />

                <!-- NAMA LENGKAP -->

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Lengkap"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextText"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_register"
                    android:hint="Masukkan nama lengkap"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8FA6C8"
                    android:textSize="14sp" />

                <!-- EMAIL -->

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Alamat Email"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextTextEmailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_register"
                    android:hint="contoh@email.com"
                    android:inputType="textEmailAddress"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8FA6C8"
                    android:textSize="14sp" />

                <!-- ALAMAT -->

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Alamat Lengkap"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextText2"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_register"
                    android:gravity="top|start"
                    android:hint="Masukkan alamat tempat tinggal"
                    android:inputType="textPostalAddress|textMultiLine"
                    android:minLines="2"
                    android:padding="15dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8FA6C8"
                    android:textSize="14sp" />

                <!-- NOMOR HP -->

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Nomor HP"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextPhone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_register"
                    android:hint="Contoh: 081234567890"
                    android:inputType="phone"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8FA6C8"
                    android:textSize="14sp" />

                <!-- PASSWORD -->

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Password"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_register"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#00F5FF"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextTextPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="Buat password"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:singleLine="true"
                        android:includeFontPadding="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8FA6C8"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- KONFIRMASI PASSWORD -->

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Konfirmasi Password"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_register"
                    app:boxBackgroundMode="none"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#00F5FF"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTextTextPassword2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:hint="Ulangi password"
                        android:inputType="textPassword"
                        android:paddingStart="15dp"
                        android:paddingEnd="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:singleLine="true"
                        android:includeFontPadding="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8FA6C8"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TOMBOL DAFTAR -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="26dp"
                    android:text="DAFTAR SEKARANG"
                    android:textAllCaps="false"
                    android:textColor="#07111F"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#00DDF5"
                    app:cornerRadius="15dp"
                    app:elevation="6dp"
                    app:strokeColor="#00F5FF"
                    app:strokeWidth="1dp"
                    app:rippleColor="#553BBDFF" />

                <!-- CATATAN -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="Pastikan data yang kamu masukkan sudah benar."
                    android:textColor="#AFC4E2"
                    android:textSize="11sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="MY LAUNDRY  •  CLEAN &amp; CARE"
            android:textColor="#00F5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>