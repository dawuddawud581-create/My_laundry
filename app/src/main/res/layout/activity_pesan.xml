<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollPesan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B18"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/mainPesan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- HEADER NEON -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@drawable/bgn"
            android:minHeight="280dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnKembaliPesan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="#152C46"
                    android:clickable="true"
                    android:contentDescription="Kembali"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#00F5FF"
                    android:textSize="34sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.16"
                        android:text="MY LAUNDRY"
                        android:textColor="#00F5FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Buat Pesanan"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_register"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#00F5FF"
                    android:textSize="24sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Pakaian Bersih Dimulai Di Sini"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Isi detail cucianmu. Kami akan membantu merawat pakaianmu dengan maksimal."
                android:textColor="#C4D7EF"
                android:textSize="13sp" />

            <!-- INDIKATOR LANGKAH -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#00F5FF"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#080B18"
                    android:textStyle="bold" />

                <View
                    android:layout_width="35dp"
                    android:layout_height="2dp"
                    android:background="#00F5FF" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#20334D"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <View
                    android:layout_width="35dp"
                    android:layout_height="2dp"
                    android:background="#20334D" />

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="#20334D"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Detail • Layanan • Konfirmasi"
                    android:textColor="#C4D7EF"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- KONTEN FORM -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- INFORMASI PELANGGAN -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="14dp"
                android:text="01  Informasi Pelanggan"
                android:textColor="#00F5FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card_neon">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Pelanggan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNamaPelanggan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_neon"
                    android:hint="Masukkan nama lengkap"
                    android:inputType="textCapWords"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8290A5"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="Nomor Telepon"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTeleponPelanggan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_neon"
                    android:hint="Contoh: 08xxxxxxxxxx"
                    android:inputType="phone"
                    android:maxLength="15"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8290A5"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="Alamat / Catatan Lokasi"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtAlamatPelanggan"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_neon"
                    android:gravity="top|start"
                    android:hint="Alamat atau catatan tambahan..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8290A5"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- PILIHAN LAYANAN -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:layout_marginBottom="6dp"
                android:text="02  Pilih Layanan"
                android:textColor="#00F5FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Pilih perawatan yang sesuai dengan pakaianmu."
                android:textColor="#A7B4D0"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/radioJenisLayanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioReguler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_neon"
                    android:buttonTint="#00F5FF"
                    android:checked="true"
                    android:lineSpacingExtra="5dp"
                    android:padding="17dp"
                    android:text="🧺  Laundry Reguler\n      Bersih dan wangi setiap hari"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioKilat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_neon"
                    android:buttonTint="#00F5FF"
                    android:lineSpacingExtra="5dp"
                    android:padding="17dp"
                    android:text="⚡  Laundry Kilat\n      Untuk kebutuhan lebih cepat"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/radioExpress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_neon"
                    android:buttonTint="#00F5FF"
                    android:lineSpacingExtra="5dp"
                    android:padding="17dp"
                    android:text="✨  Laundry Express\n      Prioritas penanganan cucian"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </RadioGroup>

            <!-- DETAIL CUCIAN -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:layout_marginBottom="14dp"
                android:text="03  Detail Cucian"
                android:textColor="#00F5FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card_neon">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berat Cucian (kg)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtBeratCucian"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_neon"
                    android:hint="Masukkan berat, contoh: 3"
                    android:inputType="numberDecimal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8290A5"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Tanggal Pesanan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTanggalPesanan"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_neon"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Pilih tanggal pesanan"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8290A5"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Catatan Cucian"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCatatanCucian"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_neon"
                    android:gravity="top|start"
                    android:hint="Contoh: pakaian putih dipisahkan..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8290A5"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ESTIMASI HARGA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card_neon">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTIMASI BIAYA"
                    android:textColor="#00F5FF"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEstimasiHarga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Rp 0"
                    android:textColor="#39FF88"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Biaya akhir dapat disesuaikan berdasarkan berat dan layanan yang dipilih."
                    android:textColor="#A7B4D0"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- TOMBOL BUAT PESANAN -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuatPesanan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Buat Pesanan Sekarang  →"
                android:textAllCaps="false"
                android:textColor="#080B18"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#00F5FF"
                app:cornerRadius="16dp"
                app:elevation="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="MY LAUNDRY  •  CLEAN CARE, HAPPY LIFE"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:letterSpacing="0.06" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>